    Source: 'crates/mneme-kernel/src/completeness.rs', lines 53:0-61:1
    Visibility: public -/
def completeness.combine_coverage
  (left : completeness.Coverage) (right : completeness.Coverage) :
  Result completeness.Coverage
  := do
  match left with
  | completeness.Coverage.Complete =>
    match right with
    | completeness.Coverage.Complete => ok completeness.Coverage.Complete
    | completeness.Coverage.Incomplete => ok completeness.Coverage.Incomplete
    | completeness.Coverage.Unknown => ok completeness.Coverage.Unknown
  | completeness.Coverage.Incomplete =>
    match right with
    | completeness.Coverage.Complete => ok completeness.Coverage.Incomplete
    | completeness.Coverage.Incomplete => ok completeness.Coverage.Incomplete
    | completeness.Coverage.Unknown => ok completeness.Coverage.Unknown
  | completeness.Coverage.Unknown => ok completeness.Coverage.Unknown

