/-- [mneme_kernel::isolation::reference_allowed]:
    Source: 'crates/mneme-kernel/src/isolation.rs', lines 39:0-48:1
    Visibility: public -/
def isolation.reference_allowed
  (facts : isolation.ReferenceFacts) : Result Bool := do
  if facts.same_scope
  then ok true
  else
    if facts.target_authorized
    then
      let b ←
        match facts.source_class with
        | isolation.ScopeClass.Operational => ok true
        | isolation.ScopeClass.Hypothesis => ok false
      let b1 ←
        if b
        then
          match facts.target_class with
          | isolation.ScopeClass.Operational => ok false
          | isolation.ScopeClass.Hypothesis => ok true
        else ok false
      ok (¬ b1)
    else ok false

