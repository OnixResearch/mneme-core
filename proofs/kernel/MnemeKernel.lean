def extent.floor_boundary_loop.body
  (bytes : Slice Std.U8) (position : Std.Usize) :
  Result (ControlFlow Std.Usize Std.Usize)
  := do
  if position > 0#usize
  then
    let i ← Slice.index_usize bytes position
    let b ← extent.is_continuation i
    if b
    then let position1 ← position - 1#usize
         ok (cont position1)
    else ok (done position)
  else ok (done position)

