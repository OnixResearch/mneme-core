    Visibility: public -/
def claim.kind_eq
  (left : claim.DecisionKind) (right : claim.DecisionKind) : Result Bool := do
  match left with
  | claim.DecisionKind.Acceptance =>
    match right with
    | claim.DecisionKind.Acceptance => ok true
    | claim.DecisionKind.ConflictResolution => ok false
    | claim.DecisionKind.Retraction => ok false
    | claim.DecisionKind.Supersession => ok false
  | claim.DecisionKind.ConflictResolution =>
    match right with
    | claim.DecisionKind.Acceptance => ok false
    | claim.DecisionKind.ConflictResolution => ok true
    | claim.DecisionKind.Retraction => ok false
    | claim.DecisionKind.Supersession => ok false
  | claim.DecisionKind.Retraction =>
    match right with
    | claim.DecisionKind.Acceptance => ok false
    | claim.DecisionKind.ConflictResolution => ok false
    | claim.DecisionKind.Retraction => ok true
    | claim.DecisionKind.Supersession => ok false
  | claim.DecisionKind.Supersession =>
    match right with
    | claim.DecisionKind.Acceptance => ok false
    | claim.DecisionKind.ConflictResolution => ok false
    | claim.DecisionKind.Retraction => ok false
    | claim.DecisionKind.Supersession => ok true

