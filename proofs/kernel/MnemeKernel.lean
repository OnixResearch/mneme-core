def extent.span_in_text
  (start : Std.U64) (stop : Std.U64) (text_len : Std.U64) : Result Bool := do
  if start <= stop
  then ok (stop <= text_len)
  else ok false

/-- [mneme_kernel::extent::excerpt_window]:
    Source: 'crates/mneme-kernel/src/extent.rs', lines 49:0-68:1
    Visibility: public -/
def extent.excerpt_window
  (request : extent.ExcerptRequest) : Result (Option extent.Window) := do
  let b ← extent.span_in_text request.start request.stop request.text_len
  if b
  then
    let length ← request.stop - request.start
    if length <= request.max_bytes
    then
      ok (some
        { start := request.start, stop := request.stop, truncated := false })
    else
      let i ← request.start + request.max_bytes
      ok (some { start := request.start, stop := i, truncated := true })
  else ok none

