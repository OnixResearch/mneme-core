  (facts : publish.PublicationFacts) : Result publish.PublicationDecision := do
  let is_published ←
    match facts.observed with
    | none => ok false
    | some found => hashing.digest_eq found facts.desired
  if is_published
  then ok publish.PublicationDecision.AlreadyPublished
  else
    let b ← hashing.optional_digest_eq facts.observed facts.expected
    if b
    then ok publish.PublicationDecision.Replace
    else ok publish.PublicationDecision.Diverged

