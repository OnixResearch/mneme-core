def claim.decision_backs
  (state : claim.Lifecycle) (cited : Option claim.CitedDecision) :
  Result Bool
  := do
  let o ← claim.required_decision state
  match o with
  | none => match cited with
            | none => ok true
            | some _ => ok false
  | some required =>
    match cited with
    | none => ok false
    | some decision =>
      let b ← claim.kind_eq required decision.kind
      if b
      then
        if decision.outcome_matches
        then
          if decision.targets_assertion
          then ok decision.binds_replaced_revision
          else ok false
        else ok false
      else ok false

