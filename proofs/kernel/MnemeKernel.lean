  (prior : Option claim.Lifecycle) (next : claim.Lifecycle)
  (cited : Option claim.CitedDecision) (commit : claim.CommitTimeFacts) :
  Result Bool
  := do
  let is_fresh_decision ←
    match cited with
    | none => ok true
    | some _ =>
      if commit.decision_in_batch
      then ok commit.actor_is_committer
      else ok false
  let b ← claim.transition_allowed prior next
