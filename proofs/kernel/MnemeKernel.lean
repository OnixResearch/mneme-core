/-- [mneme_kernel::purge::decide_working]:
    Source: 'crates/mneme-kernel/src/purge.rs', lines 45:0-60:1
    Visibility: public -/
def purge.decide_working
  (facts : purge.WorkingFacts) : Result purge.WorkingDecision := do
  match facts.kind with
  | purge.EntryKind.Absent => ok purge.WorkingDecision.AlreadyAbsent
  | purge.EntryKind.Regular =>
    match facts.observed with
    | none => ok purge.WorkingDecision.Unsupported
    | some found =>
      let b ← hashing.digest_eq found facts.planned
      if b
      then ok purge.WorkingDecision.Purge
      else ok purge.WorkingDecision.ExternalEdit
  | purge.EntryKind.Other => ok purge.WorkingDecision.Unsupported

