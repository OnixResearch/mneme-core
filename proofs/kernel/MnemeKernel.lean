/-- [mneme_kernel::claim::transition_allowed]:
    Source: 'crates/mneme-kernel/src/claim.rs', lines 41:0-50:1
    Visibility: public -/
def claim.transition_allowed
  (prior : Option claim.Lifecycle) (next : claim.Lifecycle) : Result Bool := do
  match prior with
  | none =>
    match next with
    | claim.Lifecycle.Proposed => ok true
    | claim.Lifecycle.Accepted => ok false
    | claim.Lifecycle.Disputed => ok false
    | claim.Lifecycle.Superseded => ok false
    | claim.Lifecycle.Retracted => ok false
  | some l =>
    match l with
    | claim.Lifecycle.Proposed => ok true
    | claim.Lifecycle.Accepted =>
      let b ←
        match next with
        | claim.Lifecycle.Proposed => ok true
        | claim.Lifecycle.Accepted => ok false
        | claim.Lifecycle.Disputed => ok false
        | claim.Lifecycle.Superseded => ok false
        | claim.Lifecycle.Retracted => ok false
      ok (¬ b)
    | claim.Lifecycle.Disputed =>
      let b ←
        match next with
        | claim.Lifecycle.Proposed => ok true
        | claim.Lifecycle.Accepted => ok false
        | claim.Lifecycle.Disputed => ok false
        | claim.Lifecycle.Superseded => ok false
        | claim.Lifecycle.Retracted => ok false
      ok (¬ b)
    | claim.Lifecycle.Superseded =>
      match next with
      | claim.Lifecycle.Proposed => ok false
      | claim.Lifecycle.Accepted => ok false
      | claim.Lifecycle.Disputed => ok false
      | claim.Lifecycle.Superseded => ok false
      | claim.Lifecycle.Retracted => ok true
    | claim.Lifecycle.Retracted => ok false

