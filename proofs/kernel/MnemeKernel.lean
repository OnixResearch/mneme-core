  let (has_pending, has_failed, is_partial1) ←
    cleanup.summarize_loop states false false is_partial 0#usize
  if has_pending
  then ok cleanup.JobSummary.Pending
  else
    if has_failed
    then ok cleanup.JobSummary.Failed
    else
      if is_partial1
      then ok cleanup.JobSummary.Partial
      else ok cleanup.JobSummary.Complete

