  := do
  let b ←
    match observed with
    | verdict.Status.Passed => ok false
    | verdict.Status.Failed => ok true
    | verdict.Status.Skipped => ok false
    | verdict.Status.Unimplemented => ok false
  if b
  then ok verdict.Status.Failed
