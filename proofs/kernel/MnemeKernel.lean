  Result Bool
  := do
  let co ← hlc.compare left right
  match co with
  | hlc.ClockOrder.Less => ok true
  | hlc.ClockOrder.Equal => ok false
  | hlc.ClockOrder.Greater => ok false

/-- [mneme_kernel::hlc::is_at_or_before]:
