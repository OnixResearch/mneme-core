    Source: 'crates/mneme-kernel/src/completeness.rs', lines 39:0-45:1
    Visibility: public -/
def completeness.answer_complete
  (facts : completeness.AnswerFacts) : Result Bool := do
  if facts.exhaustive
  then
    let b ←
      match facts.coverage with
      | completeness.Coverage.Complete => ok true
      | completeness.Coverage.Incomplete => ok false
      | completeness.Coverage.Unknown => ok false
    if b
    then
      if facts.limit_reached
      then ok false
      else
        if facts.declaration_valid
        then ok facts.generation_current
        else ok false
    else ok false
  else ok false

