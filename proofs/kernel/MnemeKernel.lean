  (state : claim.Lifecycle) : Result (Option claim.DecisionKind) := do
  match state with
  | claim.Lifecycle.Proposed => ok none
  | claim.Lifecycle.Accepted => ok (some claim.DecisionKind.Acceptance)
  | claim.Lifecycle.Disputed => ok (some claim.DecisionKind.ConflictResolution)
  | claim.Lifecycle.Superseded => ok (some claim.DecisionKind.Supersession)
  | claim.Lifecycle.Retracted => ok (some claim.DecisionKind.Retraction)

/-- [mneme_kernel::claim::kind_eq]:
