  (left : Option temporal.Period) (right : Option temporal.Period) :
  Result (Option temporal.Period)
  := do
  match left with
  | none => ok none
  | some lhs =>
    match right with
    | none => ok none
    | some rhs => temporal.intersect lhs rhs

